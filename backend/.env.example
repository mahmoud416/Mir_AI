# ─── MIR Backend — Environment Variables ──────────────────────────────────────
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=mir_db

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Supported: openai | gemini | anthropic | demo
AI_PROVIDER=demo
AI_API_KEY=your-api-key-here

# OpenAI-specific (used when AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini

# Gemini-specific (used when AI_PROVIDER=gemini)
GEMINI_MODEL=gemini-1.5-flash

# Anthropic-specific (used when AI_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─── Admin ───────────────────────────────────────────────────────────────────
# Simple token for protecting admin-only import endpoints
ADMIN_TOKEN=change-me-before-production

# ─── SAP Integration (Future) ────────────────────────────────────────────────
# Leave blank until the SAP environment is confirmed.
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_SYSTEM_ID=
